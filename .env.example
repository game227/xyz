# Django
SECRET_KEY=change-me-generate-a-real-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database: DATABASE_URL (Render/Neon) yoki USE_SQLITE=True yoki PostgreSQL maydonlari
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# USE_SQLITE=False
DB_NAME=xyz
DB_USER=xyz_user
DB_PASSWORD=1212
DB_HOST=localhost
DB_PORT=5432

# Timezone
TIME_ZONE=Asia/Tashkent

# Media fayllar uchun S3-mos ombor (ixtiyoriy, lekin Render kabi bepul
# hostinglarda TAVSIYA ETILADI — aks holda har avtomatik deployda
# yuklangan rasm/video/logo fayllari yo'qolib qoladi, chunki disk vaqtinchalik).
# Cloudflare R2, Backblaze B2 yoki AWS S3'dan birini tanlab, quyidagilarni to'ldiring:
# AWS_STORAGE_BUCKET_NAME=xyz-media
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_S3_REGION_NAME=auto
# AWS_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# AWS_S3_CUSTOM_DOMAIN=media.example.com
